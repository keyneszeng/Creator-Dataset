# Deployment profile
CREATOR_DATASET_DEPLOYMENT_MODE=local
CREATOR_DATASET_DATABASE_BACKEND=sqlite
CREATOR_DATASET_DATABASE_PATH=data/creator_dataset.sqlite3
# PostgreSQL example:
# CREATOR_DATASET_DATABASE_BACKEND=postgres
# CREATOR_DATASET_DATABASE_URL=postgresql://creator_dataset:password@localhost:5432/creator_dataset

# Object storage
CREATOR_DATASET_STORAGE_BACKEND=local
CREATOR_DATASET_STORAGE_LOCAL_DIR=data/objects

# S3-compatible storage (used when STORAGE_BACKEND=s3)
# CREATOR_DATASET_S3_BUCKET=creator-dataset
# CREATOR_DATASET_S3_REGION=ap-southeast-1
# CREATOR_DATASET_S3_ENDPOINT_URL=
# CREATOR_DATASET_S3_ACCESS_KEY_ID=
# CREATOR_DATASET_S3_SECRET_ACCESS_KEY=
# CREATOR_DATASET_S3_PREFIX=creator-dataset

# Application
CREATOR_DATASET_ENVIRONMENT=development
CREATOR_DATASET_DATA_DIR=data
CREATOR_DATASET_DATABASE_PATH=data/creator_dataset.sqlite3

# Xiaohongshu
# Paste your own authenticated browser Cookie header here.
# Never commit a real cookie to git.
CREATOR_DATASET_XHS_COOKIE=


# Durable worker / queue
CREATOR_DATASET_WORKER_POLL_SECONDS=2
CREATOR_DATASET_WORKER_LEASE_SECONDS=180
CREATOR_DATASET_WORKER_HEARTBEAT_SECONDS=45

# Shared platform request pacing across workers
CREATOR_DATASET_XHS_MIN_INTERVAL_SECONDS=1.5


# PostgreSQL connection pool per API/Worker/Scheduler process
CREATOR_DATASET_POSTGRES_POOL_MIN_SIZE=1
CREATOR_DATASET_POSTGRES_POOL_MAX_SIZE=10

# PostgreSQL cloud example:
# CREATOR_DATASET_DATABASE_BACKEND=postgres
# CREATOR_DATASET_DATABASE_URL=postgresql://user:password@host:5432/creator_dataset


# SaaS access control
# Keep false for trusted local development.
# Set true for public/SaaS deployments.
CREATOR_DATASET_SAAS_AUTH_ENABLED=false

# One-time bootstrap secret used to create the first Admin.
# Remove/rotate it after the first Admin API key is created.
CREATOR_DATASET_SAAS_BOOTSTRAP_ADMIN_KEY=

# New Member signup grant.
CREATOR_DATASET_SAAS_DEFAULT_FREE_DATASET_CREDITS=5


# WeChat Pay API v3 (future provider adapter)
# Keep secrets in a secret manager in production.
CREATOR_DATASET_WECHAT_PAY_MCH_ID=
CREATOR_DATASET_WECHAT_PAY_APP_ID=
CREATOR_DATASET_WECHAT_PAY_MINIPROGRAM_APP_ID=
CREATOR_DATASET_WECHAT_PAY_MERCHANT_SERIAL_NO=
CREATOR_DATASET_WECHAT_PAY_PRIVATE_KEY_PATH=
CREATOR_DATASET_WECHAT_PAY_API_V3_KEY=
CREATOR_DATASET_WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
CREATOR_DATASET_WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
CREATOR_DATASET_WECHAT_PAY_NOTIFY_URL=


# Optional user-connected LLM organization
CREATOR_DATASET_LLM_ENABLED=false

# 32-byte URL-safe base64 key used to encrypt user LLM API keys at rest.
# Generate once and store in a secret manager. Rotating it requires
# re-encrypting existing connections.
CREATOR_DATASET_LLM_CREDENTIAL_ENCRYPTION_KEY=

# Comma-separated exact hostnames allowed for LLM endpoints in cloud/SaaS.
# Example: api.example-llm.com,gateway.company.com
CREATOR_DATASET_LLM_ALLOWED_HOSTS=

# Local deployments may connect to custom/self-hosted endpoints.
CREATOR_DATASET_LLM_ALLOW_CUSTOM_BASE_URL_LOCAL=true

# Maximum normalized Dataset text sent to one organization request.
CREATOR_DATASET_LLM_MAX_INPUT_CHARS=120000


# Agent / MCP local development
CREATOR_DATASET_MCP_HOST=127.0.0.1
CREATOR_DATASET_MCP_PORT=8765

# Optional: run MCP as a real SaaS Member instead of local Admin.
# Useful for testing the 5-free-Dataset credit flow in ChatGPT.
CREATOR_DATASET_MCP_USER_API_KEY=


# Current personal-use Agent product is fully free.
# Keep true for the current phase. Set false only if commercial billing is
# intentionally reintroduced later.
CREATOR_DATASET_AGENT_FREE_MODE=true


# Personal cloud Agent access
# Use a long random secret in production.
CREATOR_DATASET_CLOUD_AGENT_TOKEN=

# Exact Host header values accepted by the public MCP endpoint.
# Examples:
# creator.example.com,creator.example.com:443
CREATOR_DATASET_MCP_ALLOWED_HOSTS=

# Optional comma-separated browser Origins. Server-to-server Agent clients
# normally do not send Origin.
CREATOR_DATASET_MCP_ALLOWED_ORIGINS=
